---
import '../styles/global.css';
import { getLang, guidePath, guidesByLang, homePath, languages, ui, type Lang } from '../i18n';

interface Props {
	title: string;
	description: string;
	schemas?: object[];
	/** Para páginas que no deben indexarse (p. ej. 404). */
	noindex?: boolean;
	/** Ruta de esta misma página en cada idioma en que existe (para hreflang y el selector de idioma). */
	alternates?: Partial<Record<Lang, string>>;
}

const { title, description, schemas = [], noindex = false, alternates = {} } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const { guides } = guidesByLang[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const home = homePath(lang);
const isHome = Astro.url.pathname === home;

const alternateLinks = Object.entries(alternates) as [Lang, string][];
// Para quien no habla ninguno de los idiomas, mejor el inglés que el castellano.
const xDefault = alternates.en ?? alternates.es;
const otherLanguages = (Object.keys(languages) as Lang[])
	.filter((other) => other !== lang)
	.map((other) => ({ lang: other, name: languages[other], href: alternates[other] ?? homePath(other) }));
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		{
			!noindex && alternateLinks.length > 1 && (
				<>
					{alternateLinks.map(([hreflang, path]) => (
						<link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site).href} />
					))}
					{xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).href} />}
				</>
			)
		}

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Pegatexto" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={t.ogLocale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
	</head>
	<body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
		<div class="relative flex min-h-screen flex-col">
			<nav aria-label={t.languageNav} class="absolute top-5 right-4 flex gap-2 sm:right-6">
				{
					otherLanguages.map((other) => (
						<a
							href={other.href}
							hreflang={other.lang}
							lang={other.lang}
							class="inline-flex items-center gap-1.5 rounded-md border border-stone-200 bg-white px-2.5 py-1 text-xs font-medium text-stone-600 transition-colors hover:border-teal-500 hover:text-teal-600"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								width="14"
								height="14"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<circle cx="12" cy="12" r="10" />
								<path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
							</svg>
							{other.name}
						</a>
					))
				}
			</nav>

			{
				!isHome && (
					<nav class="px-4 pt-6 text-center" aria-label={t.homeNav}>
						<a
							href={home}
							class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 transition-colors hover:text-teal-600"
						>
							<img src="/favicon.svg" alt="" width="20" height="20" />
							Pegatexto
						</a>
					</nav>
				)
			}

			<slot />

			<footer class="border-t border-stone-200 px-4 py-6 text-center text-xs text-stone-500">
				{
					guides.length > 0 && (
						<nav aria-label={t.guidesNav} class="mx-auto mb-3 flex max-w-2xl flex-wrap justify-center gap-x-4 gap-y-1">
							{guides.map((guide) => (
								<a
									href={guidePath(lang, guide.slug)}
									class="transition-colors hover:text-teal-600"
									aria-current={Astro.url.pathname === guidePath(lang, guide.slug) ? 'page' : undefined}
								>
									{guide.navLabel}
								</a>
							))}
						</nav>
					)
				}
				{t.madeBy}{' '}
				<a
					href="https://sietebits.com"
					class="font-medium text-stone-700 underline decoration-stone-300 underline-offset-2 hover:text-teal-600"
					rel="noopener"
				>
					7Bits
				</a>
			</footer>
		</div>
	</body>
</html>
