---
import Base from '../layouts/Base.astro';
import Tool from './Tool.astro';
import Faq from './Faq.astro';
import GuideLinks from './GuideLinks.astro';
import { publisher, type Guide } from '../data/guides';
import { getLang, guideAlternates, guidePath, guidesByLang, homePath, ui } from '../i18n';

interface Props {
	guide: Guide;
}

const { guide } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const { updated } = guidesByLang[lang];
const pageUrl = new URL(guidePath(lang, guide.slug), Astro.site).href;

const schemas = [
	{
		'@context': 'https://schema.org',
		'@type': 'TechArticle',
		headline: guide.h1,
		description: guide.description,
		url: pageUrl,
		inLanguage: lang,
		dateModified: updated,
		author: publisher,
		publisher,
		image: new URL('/og-image.png', Astro.site).href,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Pegatexto', item: new URL(homePath(lang), Astro.site).href },
			{ '@type': 'ListItem', position: 2, name: guide.h1, item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: guide.faq.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	},
];
---

<Base title={guide.title} description={guide.description} schemas={schemas} alternates={guideAlternates(guide.key)}>
	<header class="px-4 pt-6 pb-6 text-center sm:pt-8">
		<h1 class="text-3xl font-bold tracking-tight text-balance text-stone-900 sm:text-4xl">{guide.h1}</h1>
		<p class="mx-auto mt-3 max-w-lg text-balance text-stone-600" set:html={guide.lead} />
	</header>

	<main class="flex flex-1 flex-col items-center px-4 pb-16">
		<Tool />

		<article class="guide mx-auto mt-16 w-full max-w-2xl">
			{
				guide.sections.map((section) => (
					<section>
						<h2>{section.heading}</h2>
						<Fragment set:html={section.html} />
					</section>
				))
			}
		</article>

		<Faq items={guide.faq} />

		<GuideLinks title={t.otherGuides} exclude={guide.slug} />
	</main>
</Base>
