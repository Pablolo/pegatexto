---
import { guides } from '../data/guides';

interface Props {
	title: string;
	/** Guía actual, que se excluye del listado. */
	exclude?: string;
}

const { title, exclude } = Astro.props;
const items = guides.filter((guide) => guide.slug !== exclude);
---

<section class="mx-auto mt-16 w-full max-w-2xl" aria-labelledby="guides-title">
	<h2 id="guides-title" class="text-xl font-semibold text-stone-900">{title}</h2>
	<ul class="mt-6 grid gap-3 sm:grid-cols-2">
		{
			items.map((guide) => (
				<li>
					<a
						href={`/${guide.slug}/`}
						class="block h-full rounded-lg border border-stone-200 bg-white p-4 transition-colors hover:border-teal-500"
					>
						<span class="font-medium text-stone-900">{guide.h1}</span>
						<span class="mt-1 block text-sm leading-relaxed text-stone-600">{guide.summary}</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
