---
import Base from '../../layouts/Base.astro';
import GuideLinks from '../../components/GuideLinks.astro';
---

<Base title="Page not found | Pegatexto" description="This page doesn't exist." noindex>
	<header class="px-4 pt-6 pb-6 text-center sm:pt-8">
		<h1 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">Page not found</h1>
		<p class="mx-auto mt-3 max-w-md text-balance text-stone-600">
			This page doesn't exist. Go back to the <a
				href="/en/"
				class="font-medium text-stone-700 underline decoration-stone-300 underline-offset-2 hover:text-teal-600"
				>tool to paste text without formatting</a
			> or check out one of the guides.
		</p>
	</header>

	<main class="flex flex-1 flex-col items-center px-4 pb-16">
		<GuideLinks title="Guides" />
	</main>
</Base>
