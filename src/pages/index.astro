---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import Faq from '../components/Faq.astro';
import GuideLinks from '../components/GuideLinks.astro';
import { k, type FaqItem } from '../data/guides';

const siteUrl = new URL('/', Astro.site).href;
const title = 'Pegar sin formato online: convierte a texto plano | Pegatexto';
const description =
	'Quita el formato al texto copiado de Word, Gmail o cualquier web y conviértelo en texto plano al instante. Quita saltos de línea y cuenta palabras. Gratis.';

const shortcuts = [
	{ name: 'Navegadores y webs', detail: 'Chrome, Edge, Firefox, Gmail…', href: '/pegar-sin-formato-windows/', windows: k('Ctrl', 'Mayús', 'V'), mac: k('⌘', '⌥', '⇧', 'V') },
	{ name: 'Google Docs', href: '/pegar-sin-formato-google-docs/', windows: k('Ctrl', 'Mayús', 'V'), mac: k('⌘', '⇧', 'V') },
	{ name: 'Word', detail: 'Microsoft 365', href: '/pegar-sin-formato-word/', windows: k('Ctrl', 'Mayús', 'V'), mac: 'Pegado especial' },
	{ name: 'Apps de Mac', detail: 'Pages, Notas, Mail…', href: '/pegar-sin-formato-mac/', windows: '—', mac: k('⌘', '⌥', '⇧', 'V') },
];

const faq: FaqItem[] = [
	{
		question: '¿Qué es el texto plano y por qué querría quitar el formato?',
		answer:
			'El texto plano es texto sin ningún estilo: sin negritas, colores, tamaños de fuente ni enlaces ocultos. Cuando copias contenido de un Word, una web o un correo, suele arrastrar ese formato, lo que puede romper el diseño de destino (por ejemplo, un formulario, un CMS o un editor de código). Pegar en texto plano evita ese problema y deja el contenido limpio y consistente.',
	},
	{
		question: '¿Funciona igual en Mac que en Windows?',
		answer:
			'Sí. Pegatexto funciona en el navegador, así que el comportamiento es el mismo en Mac, Windows o Linux, y con los atajos habituales de cada sistema (Cmd+V en Mac, Ctrl+V en Windows). También funciona en el móvil.',
	},
	{
		question: '¿Se guarda mi texto en algún sitio?',
		answer:
			'No. Todo el procesamiento ocurre en tu propio navegador mediante JavaScript. El texto que pegas nunca se envía a ningún servidor ni se almacena en ningún sitio: si cierras o recargas la pestaña, desaparece.',
	},
	{
		question: '¿Funciona pegando desde Word, Gmail o Google Docs?',
		answer:
			'Sí. Pegatexto intercepta el pegado antes de que el navegador aplique el formato original, así que funciona igual venga el texto de Word, Gmail, Google Docs, una página web o cualquier otro editor con estilos.',
	},
	{
		question: '¿Se mantienen los saltos de línea, las viñetas y las tabulaciones?',
		answer:
			'Sí. Los saltos de línea y las tabulaciones se conservan tal cual. Las viñetas y numeraciones suelen llegar como caracteres de texto (•, 1., 2.…), según el programa del que copies. Si quieres unir las líneas, usa el botón «Quitar saltos de línea».',
	},
	{
		question: '¿Qué hacen los botones de debajo del cuadro de texto?',
		answer:
			'Permiten limpiar el texto después de pegarlo: quitar los símbolos de Markdown (los asteriscos y almohadillas del texto de ChatGPT y otras IA), quitar saltos de línea, quitar espacios sobrantes y caracteres invisibles, y pasar el texto a mayúsculas, minúsculas o tipo oración. Si seleccionas una parte del texto, solo se aplican a esa parte, y puedes deshacer cualquier cambio con Ctrl+Z (Cmd+Z en Mac). El contador muestra las palabras y caracteres del texto.',
	},
];

const schemas = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Pegatexto',
		url: siteUrl,
		inLanguage: 'es',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: 'Pegatexto',
		url: siteUrl,
		description,
		applicationCategory: 'UtilitiesApplication',
		operatingSystem: 'Any',
		inLanguage: 'es',
		featureList: [
			'Pegar texto sin formato',
			'Quitar Markdown del texto de ChatGPT y otras IA',
			'Quitar saltos de línea',
			'Quitar espacios extra',
			'Convertir a mayúsculas, minúsculas o tipo oración',
			'Contador de palabras y caracteres',
		],
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'EUR',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	},
];
---

<Base title={title} description={description} schemas={schemas}>
	<header class="px-4 pt-10 pb-6 text-center sm:pt-14">
		<h1 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">Pega texto sin formato</h1>
		<p class="mx-auto mt-3 max-w-md text-balance text-stone-600">
			¡Bienvenido! Pega texto con formato y <span class="bg-yellow-300/70 px-0.5"
				>conviértelo al instante en texto plano</span
			>, listo para volver a pegar donde lo necesites.
		</p>
	</header>

	<main class="flex flex-1 flex-col items-center px-4 pb-16">
		<Tool />

		<section class="guide mx-auto mt-16 w-full max-w-2xl" aria-labelledby="shortcuts-title">
			<h2 id="shortcuts-title">Atajos para pegar sin formato</h2>
			<p>
				Muchos programas tienen su propio atajo para pegar solo el texto. Si no lo recuerdas o no funciona
				donde estás, pega el texto aquí arriba y cópialo limpio.
			</p>
			<div class="mt-6 overflow-hidden rounded-lg border border-stone-200 bg-white">
				<table class="w-full text-left text-sm max-sm:block">
					<thead class="border-b border-stone-200 text-xs text-stone-500 max-sm:hidden">
						<tr>
							<th scope="col" class="px-4 py-2 font-medium">Dónde</th>
							<th scope="col" class="px-2 py-2 font-medium">Windows</th>
							<th scope="col" class="px-4 py-2 font-medium">Mac</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 max-sm:block">
						{
							shortcuts.map((row) => (
								<tr class="max-sm:grid max-sm:grid-cols-2">
									<th scope="row" class="px-4 py-3 align-top font-normal max-sm:col-span-2 max-sm:pb-1">
										<a href={row.href}>
											{row.name}
										</a>
										{row.detail && <span class="block text-xs text-stone-500">{row.detail}</span>}
									</th>
									<td
										data-label="Windows"
										class="px-2 py-3 align-top text-stone-600 max-sm:px-4 max-sm:pt-0 max-sm:before:block max-sm:before:text-xs max-sm:before:text-stone-500 max-sm:before:content-[attr(data-label)]"
										set:html={row.windows}
									/>
									<td
										data-label="Mac"
										class="px-4 py-3 align-top text-stone-600 max-sm:pt-0 max-sm:before:block max-sm:before:text-xs max-sm:before:text-stone-500 max-sm:before:content-[attr(data-label)]"
										set:html={row.mac}
									/>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<GuideLinks title="Guías paso a paso" />

		<Faq items={faq} />
	</main>
</Base>
